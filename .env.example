# Guester Çevre Değişkenleri Yapılandırma Şablonu

# Flask Uygulama Gizli Anahtarı
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Google E-posta SMTP Şifresi (Şifre Sıfırlama Kodları Gönderimi İçin)
# Google Hesabı ayarlarınızdan "Uygulama Şifresi (App Password)" alarak buraya yapıştırın.
SMTP_PASSWORD=your_google_app_password_here
EMAIL_SERVICE_URL=https://script.google.com/macros/s/your_gas_script_id/exec

# Süper Yönetici Giriş Bilgileri
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin_password_here
